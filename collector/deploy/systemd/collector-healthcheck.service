[Unit]
Description=Check FreeV2ray collector publication freshness
After=network-online.target collector.service
Wants=network-online.target
OnFailure=collector-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 10 http://127.0.0.1:8080/healthz
NoNewPrivileges=true
